<Window x:Class="EcosystemWindows.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QR Code for Connection" Height="400" Width="350"
        WindowStartupLocation="CenterOwner">
    
    <Grid Background="{StaticResource SystemControlBackgroundChromeMediumBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SystemControlBackgroundAccentBrush}" Padding="20">
            <TextBlock Text="Scan to Connect" FontSize="20" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- QR Code -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- QR Code Image -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <Image x:Name="QrCodeImage" Stretch="Uniform" Width="200" Height="200"/>
            </Border>
            
            <!-- Connection Info -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <TextBlock Text="Connection Information" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <TextBlock x:Name="IpAddressText" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceNameText" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Port: 55556" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SystemControlBackgroundChromeBlackMediumBrush}" Padding="20">
            <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" 
                    Background="{StaticResource SystemControlBackgroundAccentBrush}" Foreground="White"
                    BorderBrush="{StaticResource SystemControlBackgroundAccentBrush}" Padding="20,8" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>